[Unit]
Description=UPS Module 3S battery monitor and low-voltage shutdown
After=systemd-modules-load.service local-fs.target

[Service]
ExecStart=/usr/bin/python3 /home/muk0015/diploma_project/ups_monitor.py --status /run/ups/status --events /var/log/ups_events.log --interval 10
RuntimeDirectory=ups
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
