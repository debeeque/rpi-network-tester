#!/bin/sh
# Installed as ~/.xinitrc: the analyzer GUI replaces the desktop session.
# Exit code 3 opens the desktop; logging out of it returns to the GUI.
xset s off -dpms s noblank
cd /home/muk0015/diploma_project || exit 1
while :; do
    python3 gui_app.py >> /tmp/gui_app.log 2>&1
    if [ "$?" -eq 3 ]; then
        /etc/X11/Xsession
        pkill -x -u "$(id -u)" "openbox|lxpanel-pi|pcmanfm|xcompmgr|lxpolkit"
    fi
    sleep 2
done
